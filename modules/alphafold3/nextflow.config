process {
    withName: 'FOLD2GO:ALPHAFOLD3:HMMER' {
        cpus   = 8
        time   = { 30.m * task.attempt * query.size() }
        memory = { 24.GB * task.attempt }
    }

    withName: 'FOLD2GO:ALPHAFOLD3:MMSEQS' {
        cpus   = 32
        time   = { 5.h * task.attempt }
        memory = { 384.GB * task.attempt }
    }

    withName: 'FOLD2GO:ALPHAFOLD3:INFERENCE' {
        cpus   = 2
        time   = { 1.h * ( task.attempt ** 2 ) }
        memory = { 16.GB * task.attempt }
    }
}
