executor {
    name      = 'slurm'
    jobName   = { task.process }
}

singularity {
    libraryDir = "/fsimb/common/singularity_tools/fold2go"
}

mail {
    from = 'fold2go@imb-mainz.de'
    smtp {
        host = 'mailgate.zdv.uni-mainz.de'
        port = 25
        user = "${params.EMAIL}"
    }
}

process {
    resourceLimits = [ time: 7.d ]

    // limit the number of concurrent jobs to improve fairness across users
    maxForks = 8

    queue = { task.time <= 5.h ? 'short' : 'long' }

    withLabel: 'gpu' {
        queue            = { task.time <= 5.h ? 'gpushort' : 'gpulong' }
        clusterOptions   = '--gres=gpu:1'
    }

    withLabel: 'ssd' {
        // spinning disks via NFS are prohibitive for multiple sequence alignments
        // unfortunately, there are no SSDs mounted on hpc[1-3], so we need to send those msa jobs to hpc6
        clusterOptions   = '--nodelist=hpc6'
    }
}
