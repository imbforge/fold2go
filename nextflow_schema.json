{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://gitlab.rlp.net/imbforge/fold2go/-/raw/main/nextflow_schema.json",
    "title": "fold2go",
    "description": "Configure pipeline parameters",
    "type": "object",
    "$defs": {
        "General": {
            "title": "General options",
            "type": "object",
            "description": "Define fold2go pipeline parameters.",
            "required": ["IN", "MODEL_PRESET"],
            "properties": {
                "IN": {
                    "type": "string",
                    "format": "file-path-pattern",
                    "description": "Path to input file(s)",
                    "help_text": "Supported formats: fasta for <a href=https://github.com/google-deepmind/alphafold#examples>AlphaFold2</a>, json for <a href=https://github.com/google-deepmind/alphafold3/blob/main/docs/input.md>AlphaFold3</a> or yaml for <a href=https://github.com/jwohlwend/boltz/blob/main/docs/prediction.md#yaml-format>Boltz</a>",
                    "default": "/fsimb/common/cicd/test-data/alphafold/chains/*.json",
                    "exists": true
                },
                "MODEL_PRESET": {
                    "type": "string",
                    "description": "Model preset to use for prediction",
                    "default": "alphafold3",
                    "enum": [
                        "alphafold3",
                        "alphafold2_multimer",
                        "boltz1",
                        "boltz2",
                        "colabfold"
                    ]
                },
                "EMAIL": {
                    "type": "string",
                    "description": "Email address for notifications",
                    "default": "",
                    "hidden": true
                },
                "SAVE_MSA": {
                    "type": "boolean",
                    "description": "Save multiple sequence alignments to output directory.",
                    "default": false,
                    "hidden": true
                }
            }
        },
        "AlphaFold2": {
            "title": "AlphaFold2 options",
            "type": "object",
            "properties": {
                "ALPHAFOLD2" : {
                    "type": "object",
                    "required": ["DATABASE_DIR", "PREDICTIONS_PER_MODEL"],
                    "description": "Define AlphaFold2 parameters",
                    "properties": {
                        "DATABASE_DIR": {
                            "type": "string",
                            "format": "directory-path",
                            "description": "Path to AlphaFold2 database",
                            "default": "/mnt/storage/alphafold/v232",
                            "hidden": true,
                            "exists": true
                        },
                        "PREDICTIONS_PER_MODEL": {
                            "type": "integer",
                            "description": "Number of multimer predictions per model",
                            "default": 1
                        }
                    }
                }
            }
        },
        "AlphaFold3": {
            "title": "AlphaFold3 options",
            "type": "object",
            "properties": {
                "ALPHAFOLD3": {
                    "type": "object",
                    "required": ["DATABASE_DIR", "MODEL_DIR", "DIFFUSION_SAMPLES"],
                    "description": "Define AlphaFold3 parameters",
                    "properties": {
                        "DATABASE_DIR": {
                            "type": "string",
                            "format": "directory-path",
                            "description": "Path to AlphaFold3 database",
                            "default": "/mnt/storage/alphafold/v300",
                            "hidden": true,
                            "exists": true
                        },
                        "MODEL_DIR": {
                            "type": "string",
                            "format": "directory-path",
                            "description": "Path to AlphaFold3 model weights",
                            "default": "/mnt/storage/alphafold/v300/.model",
                            "hidden": true
                        },
                        "DIFFUSION_SAMPLES": {
                            "type": "integer",
                            "description": "Number of diffusion samples to generate",
                            "default": 1
                        }
                    }
                }
            }
        },
        "Boltz": {
            "title": "Boltz options",
            "type": "object",
            "properties": {
                "BOLTZ": {
                    "type": "object",
                    "required": ["MSA_PAIRING_STRATEGY", "MSA_SERVER_URL", "RECYCLING_STEPS", "SAMPLING_STEPS", "DIFFUSION_SAMPLES"],
                    "description": "Define Boltz parameters",
                    "properties": {
                        "MSA_PAIRING_STRATEGY": {
                            "type": "string",
                            "description": "Pairing strategy to use",
                            "default": "greedy",
                            "enum": [
                                "greedy",
                                "complete"
                            ],
                            "hidden": true
                        },
                        "MSA_SERVER_URL": {
                            "type": "string",
                            "description": "Server URL for MMseqs2 API",
                            "default": "https://api.colabfold.com",
                            "hidden": true
                        },
                        "RECYCLING_STEPS": {
                            "type": "integer",
                            "description": "Number of recycling steps to use for prediction",
                            "default": 3,
                            "hidden": true
                        },
                        "SAMPLING_STEPS": {
                            "type": "integer",
                            "description": "Number of sampling steps to use for prediction",
                            "default": 200,
                            "hidden": true
                        },
                        "DIFFUSION_SAMPLES": {
                            "type": "integer",
                            "description": "Number of diffusion samples to use for prediction",
                            "default": 1
                        },
                        "USE_KERNELS": {
                            "type": "boolean",
                            "description": "Use NVIDIA cuEquivariance kernels. Saves memory and speeds up inference but only works on newer GPU models.",
                            "default": false,
                            "hidden": true
                        }
                    }
                }
            }
        },
        "ColabFold": {
            "title": "Colabfold options",
            "type": "object",
            "properties": {
                "COLABFOLD": {
                    "type": "object",
                    "required": ["DATABASE_DIR", "MODEL_DIR", "RECYCLING_STEPS"],
                    "description": "Define ColabFold parameters",
                    "properties": {
                        "DATABASE_DIR": {
                            "type": "string",
                            "format": "directory-path",
                            "description": "Path to mmseqs2 database",
                            "default": "/mnt/storage/mmseqs2",
                            "hidden": true
                        },
                        "MODEL_DIR": {
                            "type": "string",
                            "format": "directory-path",
                            "description": "Path to ColabFold model weights",
                            "default": "/mnt/storage/colabfold",
                            "hidden": true
                        },
                        "RECYCLING_STEPS": {
                            "type": "integer",
                            "description": "Number of recycle steps to use for prediction",
                            "default": 3
                        }
                    }
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/General"
        },
        {
            "$ref": "#/$defs/AlphaFold2"
        },
        {
            "$ref": "#/$defs/AlphaFold3"
        },
        {
            "$ref": "#/$defs/Boltz"
        },
        {
            "$ref": "#/$defs/ColabFold"
        }
    ]
}
